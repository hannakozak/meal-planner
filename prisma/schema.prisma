// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String @default("New User")
  email     String   @unique(map: "user_email_idx")
  emailVerified DateTime? @db.Timestamp(6)
  image     String?
  password  String?
  role      Role   @default(USER)

  recipes   Recipe[]
  favorites Favorite[]
  mealPlans MealPlan[]
  shoppingLists ShoppingList[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}

model Recipe {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  instructions String[]
  imageUrl   String?
  cookingTime Int?
  servings    Int?
  
  author      User     @relation(fields: [authorId], references: [id])
  authorId    String   @db.Uuid

  ingredients RecipeIngredient[]
  categories  RecipeCategory[]
  favorites   Favorite[]
  mealPlans   MealPlanRecipe[]
  shoppingLists ShoppingList[]

  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @db.Timestamp(6)

  @@index([authorId])
}

model Ingredient {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique(map: "ingredient_name_idx")
  unit      String?

  caloriesPerUnit Float?
  proteinPerUnit  Float?
  carbsPerUnit    Float?
  fatsPerUnit     Float?

  recipes RecipeIngredient[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}

model RecipeIngredient {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quantity    Float?
  note String?

  recipe      Recipe   @relation(fields: [recipeId], references: [id])
  recipeId    String   @db.Uuid

  ingredient  Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId String   @db.Uuid

  @@unique([recipeId, ingredientId])
}

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique(map: "category_name_idx")
  locale String?

  recipes   RecipeCategory[]
}

model RecipeCategory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  recipe     Recipe   @relation(fields: [recipeId], references: [id])
  recipeId   String   @db.Uuid

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String   @db.Uuid

  @@unique([recipeId, categoryId])
}

model Favorite {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.Uuid

  recipe    Recipe   @relation(fields: [recipeId], references: [id])
  recipeId  String   @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@unique([userId, recipeId], name: "user_recipe_favorite_unique")
}

model MealPlan {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.Uuid
 
  weekStart DateTime @db.Date
  weekEnd   DateTime @db.Date

  meals    MealPlanRecipe[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  @@index([userId])
}

model MealPlanRecipe {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notes String?

  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id])
  mealPlanId String   @db.Uuid

  recipe     Recipe   @relation(fields: [recipeId], references: [id])
  recipeId   String   @db.Uuid

  day  WeekDay?
  mealType   MealType

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  @@index([mealPlanId])
  @@index([recipeId])
}

model ShoppingList {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.Uuid

  title    String
  items     ShoppingListItem[]
  recipe     Recipe? @relation(fields: [recipeId], references: [id])
  recipeId   String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  @@index([userId])
} 

model ShoppingListItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  quantity        Float?
  unit            String?
  isPurchased     Boolean @default(false)
  section         String?

  shoppingList    ShoppingList @relation(fields: [shoppingListId], references: [id])
  shoppingListId  String   @db.Uuid

  createdAt       DateTime @default(now()) @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @db.Timestamp(6)
}