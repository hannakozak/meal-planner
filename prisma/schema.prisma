// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum Role {
  USER
  ADMIN
}

enum Locale {
  EN
  PL
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String    @default("New User")
  email         String    @unique(map: "user_email_idx")
  emailVerified DateTime? @db.Timestamp(6)
  image         String?
  password      String?
  role          Role      @default(USER)

  recipes       Recipe[]
  favorites     Favorite[]
  mealPlans     MealPlan[]
  shoppingLists ShoppingList[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}

model Recipe {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  description  String?
  instructions String[]
  imageUrl     String?
  cookingTime  Int?
  servings     Int?

  author   User   @relation(fields: [authorId], references: [id])
  authorId String @db.Uuid

  ingredients   RecipeIngredient[]
  categories    RecipeCategory[]
  favorites     Favorite[]
  mealPlans     MealPlanRecipe[]
  shoppingLists ShoppingList[]

  translations RecipeTranslation[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  @@index([authorId])
}

model RecipeTranslation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  locale Locale

  title        String
  description  String?
  instructions String[]

  recipe   Recipe @relation(fields: [recipeId], references: [id])
  recipeId String @db.Uuid

  @@unique([recipeId, locale])
}

model Ingredient {
  id   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String  @unique(map: "ingredient_name_idx")
  unit String?

  caloriesPerUnit Float?
  proteinPerUnit  Float?
  carbsPerUnit    Float?
  fatsPerUnit     Float?

  recipes           RecipeIngredient[]
  shoppingListItems ShoppingListItem[]
  translations      IngredientTranslation[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}

model IngredientTranslation {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locale Locale
  name   String

  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  ingredientId String     @db.Uuid

  @@unique([ingredientId, locale])
}

model RecipeIngredient {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quantity Float?
  note     String?

  recipe   Recipe @relation(fields: [recipeId], references: [id])
  recipeId String @db.Uuid

  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId String     @db.Uuid

  @@unique([recipeId, ingredientId])
}

model Category {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique(map: "category_name_idx")

  recipes RecipeCategory[]

  translations CategoryTranslation[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)
}

model CategoryTranslation {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locale Locale
  name   String

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String   @db.Uuid

  @@unique([categoryId, locale])
}

model RecipeCategory {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  recipe   Recipe @relation(fields: [recipeId], references: [id])
  recipeId String @db.Uuid

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String   @db.Uuid

  @@unique([recipeId, categoryId])
}

model Favorite {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  user   User   @relation(fields: [userId], references: [id])
  userId String @db.Uuid

  recipe   Recipe @relation(fields: [recipeId], references: [id])
  recipeId String @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@unique([userId, recipeId], name: "user_recipe_favorite_unique")
}

model MealPlan {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user   User   @relation(fields: [userId], references: [id])
  userId String @db.Uuid

  weekStart DateTime @db.Date
  weekEnd   DateTime @db.Date

  meals        MealPlanRecipe[]
  translations MealPlanTranslation[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  @@index([userId])
}

model MealPlanTranslation {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locale Locale
  name   String?

  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  mealPlanId String   @db.Uuid

  @@unique([mealPlanId, locale])
}

model MealPlanRecipe {
  id    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notes String?

  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id])
  mealPlanId String   @db.Uuid

  recipe   Recipe @relation(fields: [recipeId], references: [id])
  recipeId String @db.Uuid

  day      WeekDay?
  mealType MealType

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  @@index([mealPlanId])
  @@index([recipeId])
}

model ShoppingList {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user   User   @relation(fields: [userId], references: [id])
  userId String @db.Uuid

  title        String
  items        ShoppingListItem[]
  recipe       Recipe?                   @relation(fields: [recipeId], references: [id])
  recipeId     String?                   @db.Uuid
  translations ShoppingListTranslation[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  @@index([userId])
}

model ShoppingListTranslation {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locale Locale
  title  String

  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  shoppingListId String       @db.Uuid

  @@unique([shoppingListId, locale])
}

model ShoppingListItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  quantity    Float?
  unit        String?
  isPurchased Boolean @default(false)
  section     String?

  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id])
  shoppingListId String       @db.Uuid

  ingredientId String? @db.Uuid
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id])

  translations ShoppingListItemTranslation[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}

model ShoppingListItemTranslation {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locale  Locale
  section String?

  shoppingListItem   ShoppingListItem @relation(fields: [shoppingListItemId], references: [id], onDelete: Cascade)
  shoppingListItemId String           @db.Uuid

  @@unique([shoppingListItemId, locale])
}
